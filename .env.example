# ============================================================
# .env.example — Stripe Business Case
# Copy to .env and fill in your actual values.
# NEVER commit .env to the repository.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=stripe

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=stripe_nosql

# ── Airflow ──────────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
# AIRFLOW_ADMIN_PASSWORD is prompted at runtime via read -s
# to avoid storing it anywhere in plain text

# ── Debezium / CDC ───────────────────────────────────────────
PG_CDC_USER=cdc_user
PG_CDC_PASSWORD=your_cdc_password_here

# ── Snowflake / dbt ──────────────────────────────────────────
DBT_SNOWFLAKE_ACCOUNT=your_account.eu-west-1
DBT_SNOWFLAKE_USER=your_user
DBT_SNOWFLAKE_PASSWORD=your_password_here
DBT_SNOWFLAKE_DATABASE=STRIPE_DB
DBT_SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
DBT_SNOWFLAKE_SCHEMA=public

# ── ML serving (FastAPI) ─────────────────────────────────────
ML_API_URL=http://localhost:8000
FRAUD_SCORE_THRESHOLD=0.5

# ── Kafka / Faust ────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092

# ── Schema Registry (Debezium Avro) ─────────────────────────
SCHEMA_REGISTRY_URL=http://localhost:8081
